{
  "info": {
    "_postman_id": "meeting-calendar-api-collection",
    "name": "Meeting Calendar Assistant API",
    "description": "Complete API collection for testing the Meeting Calendar Assistant application with working examples",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "✅ Employee Management",
      "item": [
        {
          "name": "✅ GET All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "✅ GET John Doe by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "1"]
            }
          }
        },
        {
          "name": "✅ CREATE New Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Test Employee\",\n  \"email\": \"newtest@company.com\",\n  \"department\": \"Testing\",\n  \"designation\": \"QA Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        }
      ]
    },
    {
      "name": "✅ Meeting Management",
      "item": [
        {
          "name": "✅ GET All Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "✅ BOOK Meeting (Future Date)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Team Meeting\",\n  \"description\": \"Weekly team sync meeting\",\n  \"startTime\": \"2025-07-12 10:00:00\",\n  \"endTime\": \"2025-07-12 11:00:00\",\n  \"organizerEmail\": \"john.doe@company.com\",\n  \"participantEmails\": [\"bob.wilson@company.com\"],\n  \"location\": \"Conference Room B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "✅ CHECK Conflicts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantEmails\": [\"john.doe@company.com\", \"bob.wilson@company.com\"],\n  \"startTime\": \"2025-07-12 10:30:00\",\n  \"endTime\": \"2025-07-12 11:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/conflicts",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "conflicts"]
            }
          }
        }
      ]
    },
    {
      "name": "✅ Calendar Features",
      "item": [
        {
          "name": "✅ FIND Free Slots",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee1Email\": \"bob.wilson@company.com\",\n  \"employee2Email\": \"alice.cooper@company.com\",\n  \"startDate\": \"2025-07-13 09:00:00\",\n  \"endDate\": \"2025-07-13 18:00:00\",\n  \"meetingDurationMinutes\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/calendar/free-slots",
              "host": ["{{baseUrl}}"],
              "path": ["calendar", "free-slots"]
            }
          }
        },
        {
          "name": "✅ GET Employee Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/calendar/free-slots/alice.cooper@company.com?start=2025-07-13 09:00:00&end=2025-07-13 18:00:00&duration=60",
              "host": ["{{baseUrl}}"],
                              "path": ["calendar", "free-slots", "alice.cooper@company.com"],
                "query": [
                  {
                    "key": "start",
                    "value": "2025-07-13 09:00:00"
                  },
                  {
                    "key": "end",
                    "value": "2025-07-13 18:00:00"
                  },
                  {
                    "key": "duration",
                    "value": "60"
                  }
                ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    }
  ]
} 