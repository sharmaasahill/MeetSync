{
  "info": {
    "_postman_id": "meeting-calendar-api-collection",
    "name": "MeetSync API",
    "description": "API collection for testing MeetSync. Sample meetings are created for the day after the server starts, so update the dates below to a future date before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Employee Management",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Get Rahul Mehta by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "1"]
            }
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ananya Gupta\",\n  \"email\": \"ananya.gupta@company.com\",\n  \"department\": \"Testing\",\n  \"designation\": \"QA Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        }
      ]
    },
    {
      "name": "Meeting Management",
      "item": [
        {
          "name": "Get All Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "Book Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team Sync\",\n  \"description\": \"Weekly team sync meeting\",\n  \"startTime\": \"2026-12-15 10:00:00\",\n  \"endTime\": \"2026-12-15 11:00:00\",\n  \"organizerEmail\": \"rahul.mehta@company.com\",\n  \"participantEmails\": [\"amit.verma@company.com\"],\n  \"location\": \"Conference Room B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "Check Conflicts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantEmails\": [\"rahul.mehta@company.com\", \"amit.verma@company.com\"],\n  \"startTime\": \"2026-12-15 10:30:00\",\n  \"endTime\": \"2026-12-15 11:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/conflicts",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "conflicts"]
            }
          }
        }
      ]
    },
    {
      "name": "Calendar",
      "item": [
        {
          "name": "Find Free Slots",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee1Email\": \"amit.verma@company.com\",\n  \"employee2Email\": \"sneha.iyer@company.com\",\n  \"startDate\": \"2026-12-15 09:00:00\",\n  \"endDate\": \"2026-12-15 18:00:00\",\n  \"meetingDurationMinutes\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/calendar/free-slots",
              "host": ["{{baseUrl}}"],
              "path": ["calendar", "free-slots"]
            }
          }
        },
        {
          "name": "Get Employee Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/calendar/free-slots/sneha.iyer@company.com?start=2026-12-15 09:00:00&end=2026-12-15 18:00:00&duration=60",
              "host": ["{{baseUrl}}"],
              "path": ["calendar", "free-slots", "sneha.iyer@company.com"],
              "query": [
                {
                  "key": "start",
                  "value": "2026-12-15 09:00:00"
                },
                {
                  "key": "end",
                  "value": "2026-12-15 18:00:00"
                },
                {
                  "key": "duration",
                  "value": "60"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    }
  ]
}
